{
  "name": "dsh-whisper-ru",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Local Whisper speech recognition for DeepSeek Harness voice input, with Russian and nine other recognition languages.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "speech-to-text",
    "whisper",
    "russian",
    "offline"
  ],
  "license": "MIT",
  "author": "tribesman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tribesman/dsh-whisper-ru.git"
  },
  "homepage": "https://github.com/tribesman/dsh-whisper-ru#readme",
  "bugs": {
    "url": "https://github.com/tribesman/dsh-whisper-ru/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "worker.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "README.ar.md",
    "README.es.md",
    "README.pt.md",
    "LICENSE"
  ],
  "dependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
